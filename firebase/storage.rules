rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Public image-hosting area used by my:code.
    // Anyone can upload an image, but only image files under 10 MB are accepted.
    // Existing files cannot be overwritten or deleted from the public client.
    match /public/{allPaths=**} {
      allow read: if true;
      allow create: if request.resource != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }
  }
}
